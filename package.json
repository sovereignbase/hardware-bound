{
  "type": "module",
  "license": "Apache-2.0",
  "name": "@sovereignbase/hardware-bound",
  "version": "1.0.0",
  "description": "Creates a device-bound browser credential and derives stable entropy bytes from it for bootstrapping local cryptographic state.",
  "keywords": [
    "entropy",
    "device-binding",
    "hardware-bound",
    "local-first",
    "zero-knowledge",
    "bootstrap",
    "cryptography",
    "prf",
    "sovereignbase",
    "typescript"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "format": "prettier . --write",
    "build": "tsdown && node in-browser-testing-build.js",
    "test": "npm run build && npm run test:typecheck && vitest run && node test/e2e/run.mjs",
    "test:typecheck": "tsc --noEmit --project test/tsconfig.json",
    "prepare": "husky",
    "prepublishOnly": "npm run test"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@sovereignbase/bytecodec": "^1.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sovereignbase/hardware-bound.git"
  },
  "bugs": {
    "url": "https://github.com/sovereignbase/hardware-bound/issues"
  },
  "homepage": "https://sovereignbase.dev/hardware-bound"
}
