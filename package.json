{
  "type": "module",
  "license": "Apache-2.0",
  "name": "@sovereignbase/hardware-bound",
  "version": "0.0.0",
  "description": "Browser-first WebAuthn helpers for creating a device binding and deriving hardware-bound entropy.",
  "keywords": [
    "webauthn",
    "passkeys",
    "browser",
    "entropy",
    "device-binding",
    "hardware-bound",
    "prf",
    "sovereignbase",
    "typescript"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "format": "prettier . --write",
    "build": "tsup && node in-browser-testing-build.js",
    "test": "npm run build && node test/run-coverage.mjs && node test/e2e/run.mjs",
    "prepare": "husky",
    "prepublishOnly": "npm run test"
  },
  "c8": {
    "all": true,
    "include": [
      "dist/**/*.js"
    ],
    "exclude": [
      "dist/**/*.d.ts",
      "test/**",
      "benchmark/**",
      "playwright.config.ts"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.5.0",
    "c8": "^11.0.0",
    "edge-runtime": "^4.0.1",
    "fast-glob": "^3.3.3",
    "husky": "^9.1.7",
    "playwright": "^1.59.1",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.79.0"
  },
  "dependencies": {
    "@sovereignbase/bytecodec": "^1.5.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sovereignbase/hardware-bound.git"
  },
  "bugs": {
    "url": "https://github.com/sovereignbase/hardware-bound/issues"
  },
  "homepage": "https://sovereignbase.dev/hardware-bound"
}
