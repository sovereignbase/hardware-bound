{
  "type": "module",
  "license": "Apache-2.0",
  "name": "@sovereignbase/hardware-bound",
  "version": "2.0.2",
  "description": "Enables device-bound cryptography in the browser through an offline-capable WebAuthn wrapper.",
  "keywords": [
    "prf",
    "webauthn",
    "device-bound",
    "cryptography"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "format": "prettier . --write",
    "build": "npm run build:package && npm run build:docs",
    "build:package": "tsdown",
    "build:docs": "typedoc",
    "test": "npm run build && npm run test:typecheck && vitest run && node test/e2e/run.mjs",
    "test:typecheck": "tsc --noEmit --project test/tsconfig.json",
    "prepare": "husky",
    "prepublishOnly": "npm run test"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.3",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@sovereignbase/bytecodec": "^2.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sovereignbase/hardware-bound.git"
  },
  "bugs": {
    "url": "https://github.com/sovereignbase/hardware-bound/issues"
  },
  "homepage": "https://sovereignbase.dev/hardware-bound",
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
